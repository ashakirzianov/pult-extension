{
  "name": "pult-extension",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter ./extension build",
    "watch": "pnpm --filter ./extension watch",
    "package": "pnpm --filter ./extension package",
    "vendor:sync": "node scripts/vendor.ts",
    "vendor:check": "node scripts/vendor.ts --check",
    "typecheck": "tsc --noEmit -p scripts && pnpm -r typecheck",
    "test": "vp test run",
    "lint": "vp lint --report-unused-disable-directives",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^24.13.1"
  },
  "packageManager": "pnpm@11.10.0"
}
