{
  "name": "pult",
  "displayName": "Pult",
  "version": "0.0.1",
  "private": true,
  "description": "Pult's client for T3 Code: agent threads in the editor.",
  "categories": [
    "AI",
    "Chat"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ashakirzianov/pult-extension.git"
  },
  "publisher": "pult",
  "browser": "./dist/web/extension.js",
  "scripts": {
    "bundle:host": "esbuild src/extension.ts --bundle --platform=browser --format=cjs --target=es2022 --external:vscode --define:globalThis.location=undefined --outfile=dist/web/extension.js",
    "bundle:webview": "vp build --config webview/vite.config.ts",
    "build": "pnpm run bundle:host --sourcemap && pnpm run bundle:webview --sourcemap",
    "watch": "pnpm run bundle:host --sourcemap --watch",
    "watch:webview": "pnpm run bundle:webview --sourcemap --watch",
    "vscode:prepublish": "pnpm run bundle:host --minify && pnpm run bundle:webview",
    "package": "mkdir -p ../release && vsce package --no-dependencies --out ../release/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p webview"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@base-ui/react": "1.5.0",
    "@daypicker/react": "10.0.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@effect/atom-react": "catalog:",
    "@legendapp/list": "catalog:",
    "@noble/hashes": "catalog:",
    "@pierre/diffs": "catalog:",
    "@pierre/trees": "1.0.0-beta.4",
    "@rolldown/plugin-babel": "0.2.3",
    "@t3tools/client-runtime": "workspace:*",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-pacer": "0.19.4",
    "@tanstack/react-router": "1.170.10",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-code": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@types/culori": "4.0.1",
    "@types/mdast": "4.0.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@types/vscode": "1.110.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vscode/test-web": "0.0.81",
    "@vscode/vsce": "4.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "0.7.1",
    "culori": "4.0.2",
    "dompurify": "3.4.16",
    "effect": "catalog:",
    "esbuild": "0.28.2",
    "hast-util-to-html": "9.0.5",
    "hast-util-to-jsx-runtime": "2.3.6",
    "heic-to": "1.5.2",
    "jose": "catalog:",
    "lucide": "0.564.0",
    "lucide-react": "0.564.0",
    "mermaid": "11.17.2",
    "morphicons": "1.7.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "unbash": "5.0.0",
    "unified": "11.0.5",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zustand": "5.0.14"
  },
  "contributes": {
    "commands": [
      {
        "command": "pult.connect",
        "title": "Connect to Environment",
        "category": "Pult",
        "icon": "$(plug)"
      },
      {
        "command": "pult.disconnect",
        "title": "Disconnect",
        "category": "Pult",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "pult.forget",
        "title": "Forget Environment",
        "category": "Pult"
      },
      {
        "command": "pult.openProject",
        "title": "Open Project…",
        "category": "Pult",
        "icon": "$(folder-opened)"
      },
      {
        "command": "pult.goToFile",
        "title": "Go to File…",
        "category": "Pult"
      },
      {
        "command": "pult.searchInFiles",
        "title": "Search in Files…",
        "category": "Pult"
      },
      {
        "command": "pult.newThread",
        "title": "New Thread",
        "category": "Pult",
        "icon": "$(add)"
      },
      {
        "command": "pult.newThreadInProject",
        "title": "New Thread in Project",
        "category": "Pult"
      },
      {
        "command": "pult.openThread",
        "title": "Open Thread",
        "category": "Pult"
      },
      {
        "command": "pult.openThreadToSide",
        "title": "Open to the Side",
        "category": "Pult",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "pult.pinThread",
        "title": "Pin Thread",
        "category": "Pult",
        "icon": "$(pin)"
      },
      {
        "command": "pult.unpinThread",
        "title": "Unpin Thread",
        "category": "Pult",
        "icon": "$(pinned)"
      },
      {
        "command": "pult.settleThread",
        "title": "Settle Thread",
        "category": "Pult",
        "icon": "$(pass)"
      },
      {
        "command": "pult.unsettleThread",
        "title": "Un-settle Thread",
        "category": "Pult",
        "icon": "$(circle-large-outline)"
      },
      {
        "command": "pult.snoozeThread",
        "title": "Snooze Thread…",
        "category": "Pult",
        "icon": "$(clock)"
      },
      {
        "command": "pult.unsnoozeThread",
        "title": "Wake Thread",
        "category": "Pult",
        "icon": "$(bell)"
      },
      {
        "command": "pult.copyThreadLink",
        "title": "Copy Thread Link",
        "category": "Pult",
        "icon": "$(link)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pult",
          "title": "Pult",
          "icon": "media/pult.svg"
        }
      ]
    },
    "views": {
      "pult": [
        {
          "id": "pult.threads",
          "name": "Threads"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pult.threads",
        "contents": "Pult is not connected to a T3 Code environment.\n[Connect](command:pult.connect)",
        "when": "!pult.bound"
      },
      {
        "view": "workbench.explorer.emptyView",
        "contents": "Open a project of the connected T3 Code environment as a workspace folder.\n[Open Project](command:pult.openProject)",
        "when": "pult.bound && workspaceFolderCount == 0"
      }
    ],
    "customEditors": [
      {
        "viewType": "pult.thread",
        "displayName": "Pult Thread",
        "selector": [
          {
            "filenamePattern": "pult-thread:/**"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pult.disconnect",
          "when": "pult.bound"
        },
        {
          "command": "pult.openProject",
          "when": "pult.bound"
        },
        {
          "command": "pult.goToFile",
          "when": "pult.bound && pult.workspace"
        },
        {
          "command": "pult.searchInFiles",
          "when": "pult.bound && pult.workspace"
        },
        {
          "command": "pult.newThread",
          "when": "pult.bound"
        },
        {
          "command": "pult.openThread",
          "when": "false"
        },
        {
          "command": "pult.openThreadToSide",
          "when": "false"
        },
        {
          "command": "pult.newThreadInProject",
          "when": "activeCustomEditorId == pult.thread"
        },
        {
          "command": "pult.pinThread",
          "when": "activeCustomEditorId == pult.thread && pult.threadPinning"
        },
        {
          "command": "pult.unpinThread",
          "when": "activeCustomEditorId == pult.thread && pult.threadPinning"
        },
        {
          "command": "pult.settleThread",
          "when": "activeCustomEditorId == pult.thread && pult.threadSettlement"
        },
        {
          "command": "pult.unsettleThread",
          "when": "activeCustomEditorId == pult.thread && pult.threadSettlement"
        },
        {
          "command": "pult.snoozeThread",
          "when": "activeCustomEditorId == pult.thread && pult.threadSnooze"
        },
        {
          "command": "pult.unsnoozeThread",
          "when": "activeCustomEditorId == pult.thread && pult.threadSnooze"
        },
        {
          "command": "pult.copyThreadLink",
          "when": "activeCustomEditorId == pult.thread"
        }
      ],
      "view/title": [
        {
          "command": "pult.newThread",
          "when": "view == pult.threads && pult.bound",
          "group": "navigation@1"
        },
        {
          "command": "pult.openProject",
          "when": "view == pult.threads && pult.bound",
          "group": "navigation"
        },
        {
          "command": "pult.connect",
          "when": "view == pult.threads && !pult.bound",
          "group": "navigation"
        },
        {
          "command": "pult.disconnect",
          "when": "view == pult.threads && pult.bound",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "pult.pinThread",
          "when": "view == pult.threads && viewItem == thread-active && pult.threadPinning",
          "group": "inline@1"
        },
        {
          "command": "pult.unpinThread",
          "when": "view == pult.threads && viewItem == thread-pinned && pult.threadPinning",
          "group": "inline@1"
        },
        {
          "command": "pult.snoozeThread",
          "when": "view == pult.threads && viewItem =~ /^thread-(active|pinned)$/ && pult.threadSnooze",
          "group": "inline@2"
        },
        {
          "command": "pult.unsnoozeThread",
          "when": "view == pult.threads && viewItem == thread-snoozed && pult.threadSnooze",
          "group": "inline@2"
        },
        {
          "command": "pult.settleThread",
          "when": "view == pult.threads && viewItem =~ /^thread-(active|pinned)$/ && pult.threadSettlement",
          "group": "inline@3"
        },
        {
          "command": "pult.unsettleThread",
          "when": "view == pult.threads && viewItem == thread-settled && pult.threadSettlement",
          "group": "inline@3"
        },
        {
          "command": "pult.openThread",
          "when": "view == pult.threads && viewItem =~ /^thread-/",
          "group": "1_open@1"
        },
        {
          "command": "pult.openThreadToSide",
          "when": "view == pult.threads && viewItem =~ /^thread-/",
          "group": "1_open@2"
        },
        {
          "command": "pult.pinThread",
          "when": "view == pult.threads && viewItem == thread-active && pult.threadPinning",
          "group": "2_shelve@1"
        },
        {
          "command": "pult.unpinThread",
          "when": "view == pult.threads && viewItem == thread-pinned && pult.threadPinning",
          "group": "2_shelve@1"
        },
        {
          "command": "pult.snoozeThread",
          "when": "view == pult.threads && viewItem =~ /^thread-(active|pinned)$/ && pult.threadSnooze",
          "group": "2_shelve@2"
        },
        {
          "command": "pult.unsnoozeThread",
          "when": "view == pult.threads && viewItem == thread-snoozed && pult.threadSnooze",
          "group": "2_shelve@2"
        },
        {
          "command": "pult.settleThread",
          "when": "view == pult.threads && viewItem =~ /^thread-(active|pinned)$/ && pult.threadSettlement",
          "group": "2_shelve@3"
        },
        {
          "command": "pult.unsettleThread",
          "when": "view == pult.threads && viewItem == thread-settled && pult.threadSettlement",
          "group": "2_shelve@3"
        },
        {
          "command": "pult.copyThreadLink",
          "when": "view == pult.threads && viewItem =~ /^thread-/",
          "group": "3_copy@1"
        },
        {
          "command": "pult.newThreadInProject",
          "when": "view == pult.threads && viewItem =~ /^thread-/",
          "group": "4_new@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pult.goToFile",
        "key": "ctrl+p",
        "mac": "cmd+p",
        "when": "virtualWorkspace == pult && pult.bound"
      },
      {
        "command": "pult.searchInFiles",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "virtualWorkspace == pult && pult.bound"
      }
    ],
    "colors": [
      {
        "id": "pult.ignoredResourceForeground",
        "description": "Color of an entry the environment's Git ignores, in a `pult:` workspace folder.",
        "defaults": {
          "dark": "#8C8C8C",
          "light": "#8E8E90",
          "highContrast": "#A7A8A9",
          "highContrastLight": "#8E8E90"
        }
      },
      {
        "id": "pult.threadRunning",
        "description": "A thread whose agent is running: its badge in the Pult picker and on its tab.",
        "defaults": {
          "dark": "charts.blue",
          "light": "charts.blue",
          "highContrast": "charts.blue",
          "highContrastLight": "charts.blue"
        }
      },
      {
        "id": "pult.threadWaiting",
        "description": "A thread waiting on you: an approval, a question, or a plan.",
        "defaults": {
          "dark": "charts.yellow",
          "light": "charts.yellow",
          "highContrast": "charts.yellow",
          "highContrastLight": "charts.yellow"
        }
      },
      {
        "id": "pult.threadQueued",
        "description": "A thread whose run is queued or starting.",
        "defaults": {
          "dark": "charts.purple",
          "light": "charts.purple",
          "highContrast": "charts.purple",
          "highContrastLight": "charts.purple"
        }
      },
      {
        "id": "pult.threadFailed",
        "description": "A thread whose run failed.",
        "defaults": {
          "dark": "errorForeground",
          "light": "errorForeground",
          "highContrast": "errorForeground",
          "highContrastLight": "errorForeground"
        }
      }
    ]
  },
  "activationEvents": [
    "onFileSystem:pult",
    "onStartupFinished"
  ],
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.110.0"
  },
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
