{
  "name": "pult",
  "displayName": "Pult",
  "version": "0.0.1",
  "private": true,
  "description": "Pult's client for T3 Code: agent threads in the editor.",
  "categories": [
    "AI",
    "Chat"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ashakirzianov/pult-extension.git"
  },
  "publisher": "pult",
  "browser": "./dist/web/extension.js",
  "scripts": {
    "bundle": "esbuild src/extension.ts --bundle --platform=browser --format=cjs --target=es2022 --external:vscode --define:globalThis.location=undefined --outfile=dist/web/extension.js",
    "build": "pnpm run bundle --sourcemap",
    "watch": "pnpm run bundle --sourcemap --watch",
    "vscode:prepublish": "pnpm run bundle --minify",
    "package": "mkdir -p ../release && vsce package --no-dependencies --out ../release/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@t3tools/client-runtime": "workspace:*",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "@types/vscode": "1.110.0",
    "@vscode/test-web": "0.0.81",
    "@vscode/vsce": "4.0.0",
    "effect": "catalog:",
    "esbuild": "0.28.2",
    "typescript": "catalog:"
  },
  "contributes": {
    "commands": [
      {
        "command": "pult.connect",
        "title": "Connect to Environment",
        "category": "Pult",
        "icon": "$(plug)"
      },
      {
        "command": "pult.disconnect",
        "title": "Disconnect",
        "category": "Pult",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "pult.forget",
        "title": "Forget Environment",
        "category": "Pult"
      },
      {
        "command": "pult.openProject",
        "title": "Open Project…",
        "category": "Pult",
        "icon": "$(folder-opened)"
      },
      {
        "command": "pult.goToFile",
        "title": "Go to File…",
        "category": "Pult"
      },
      {
        "command": "pult.searchInFiles",
        "title": "Search in Files…",
        "category": "Pult"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pult",
          "title": "Pult",
          "icon": "media/pult.svg"
        }
      ]
    },
    "views": {
      "pult": [
        {
          "id": "pult.threads",
          "name": "Threads"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pult.threads",
        "contents": "Pult is not connected to a T3 Code environment.\n[Connect](command:pult.connect)",
        "when": "!pult.bound"
      },
      {
        "view": "workbench.explorer.emptyView",
        "contents": "Open a project of the connected T3 Code environment as a workspace folder.\n[Open Project](command:pult.openProject)",
        "when": "pult.bound && workspaceFolderCount == 0"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pult.disconnect",
          "when": "pult.bound"
        },
        {
          "command": "pult.openProject",
          "when": "pult.bound"
        },
        {
          "command": "pult.goToFile",
          "when": "pult.bound && pult.workspace"
        },
        {
          "command": "pult.searchInFiles",
          "when": "pult.bound && pult.workspace"
        }
      ],
      "view/title": [
        {
          "command": "pult.openProject",
          "when": "view == pult.threads && pult.bound",
          "group": "navigation"
        },
        {
          "command": "pult.connect",
          "when": "view == pult.threads && !pult.bound",
          "group": "navigation"
        },
        {
          "command": "pult.disconnect",
          "when": "view == pult.threads && pult.bound",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pult.goToFile",
        "key": "ctrl+p",
        "mac": "cmd+p",
        "when": "virtualWorkspace == pult"
      },
      {
        "command": "pult.searchInFiles",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "virtualWorkspace == pult"
      }
    ],
    "colors": [
      {
        "id": "pult.ignoredResourceForeground",
        "description": "Color of an entry the environment's Git ignores, in a `pult:` workspace folder.",
        "defaults": {
          "dark": "#8C8C8C",
          "light": "#8E8E90",
          "highContrast": "#A7A8A9",
          "highContrastLight": "#8E8E90"
        }
      }
    ]
  },
  "activationEvents": [
    "onFileSystem:pult",
    "onStartupFinished"
  ],
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.110.0"
  },
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
